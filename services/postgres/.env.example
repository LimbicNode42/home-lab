# Render this from Vaultwarden before applying. Do not commit a real .env.
POSTGRESQL_PASSWORD=REPLACE_WITH_VAULTWARDEN_POSTGRESQL_PASSWORD
POSTGRESQL_POSTGRES_PASSWORD=REPLACE_WITH_VAULTWARDEN_POSTGRESQL_POSTGRES_PASSWORD
POSTGRESQL_TLS_ENABLED=yes
POSTGRESQL_TLS_CERT_FILE=/opt/bitnami/postgresql/certs/postgres.crt
POSTGRESQL_TLS_KEY_FILE=/opt/bitnami/postgresql/certs/postgres.key
