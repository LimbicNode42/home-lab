# hermes-discord environment variables
#
# Copy this file to .env in the same directory as compose.yaml,
# then fill in values from Vaultwarden (folder: homelab / hermes-discord).
#
# NEVER commit .env — it contains secrets. Only env.example belongs in Git.
# Mode: chmod 600 .env
#

# ── Image ────────────────────────────────────────────────────────────────────
# Image name (default: hermes-agent if built locally)
HERMES_IMAGE=hermes-agent

# Image digest pinned to the currently running instance.
# Resolve with:
#   docker image inspect $(docker inspect hermes --format '{{.Image}}') \
#     --format '{{index .RepoDigests 0}}'
# Paste the sha256:... portion here.
HERMES_IMAGE_DIGEST=sha256:REPLACE_WITH_RUNNING_DIGEST

# ── UID/GID ──────────────────────────────────────────────────────────────────
# Set to the host user that owns ~/.hermes / HERMES_DATA_DIR.
HERMES_UID=1000
HERMES_GID=1000

# ── Data directory ────────────────────────────────────────────────────────────
# Host path mounted as /opt/data inside the container.
# Must contain a configured Hermes profile (config.yaml, .env, profiles/, etc.)
HERMES_DATA_DIR=/opt/hermes-data

# ── Discord (REQUIRED) ────────────────────────────────────────────────────────
# Vaultwarden: homelab / hermes-discord / bot_token
DISCORD_BOT_TOKEN=REPLACE_WITH_VAULTWARDEN_DISCORD_BOT_TOKEN

# ── Discord (OPTIONAL) ────────────────────────────────────────────────────────
# Vaultwarden: homelab / hermes-discord / allowed_users
# Comma-separated Discord user IDs (get with: right-click user → Copy ID)
DISCORD_ALLOWED_USERS=REPLACE_WITH_DISCORD_USER_IDS

# Vaultwarden: homelab / hermes-discord / home_channel_id
# Numeric ID of the default delivery channel for cron jobs and notifications.
DISCORD_HOME_CHANNEL=REPLACE_WITH_DISCORD_CHANNEL_ID

# Comma-separated channel IDs allowed to use slash commands.
# Leave empty to allow all channels the bot can see (narrowed by ALLOWED_USERS).
DISCORD_ALLOWED_CHANNELS=

# Slash command sync: safe | bulk | off  (default: safe)
DISCORD_COMMAND_SYNC_POLICY=safe

# Hide /kanban commands from non-admin members: true | false  (default: false)
DISCORD_HIDE_SLASH_COMMANDS=false

# ── LLM provider ─────────────────────────────────────────────────────────────
# If these are already in the Hermes profile config on the mounted volume,
# you can leave them blank here — the gateway reads from /opt/data.
# Otherwise uncomment and fill from Vaultwarden: homelab / llm-provider /
# OPENAI_API_KEY=REPLACE_WITH_VAULTWARDEN_OPENAI_API_KEY
# ANTHROPIC_API_KEY=REPLACE_WITH_VAULTWARDEN_ANTHROPIC_API_KEY
