# hermes-discord — Vaultwarden secrets reference map
#
# This file maps compose/env variables to Vaultwarden items.
# Use it to know where to look in Bitwarden/Vaultwarden when rendering .env.
# Do NOT put values here. This is a reference document.
#
# Vaultwarden URL: http://192.168.0.50:8084
# Folder: homelab
# CLI: bw config server http://192.168.0.50:8084 && bw login --apikey
#

# ── Item: hermes-discord ─────────────────────────────────────────────────────
#   bw get item "hermes/discord"
#
#   field: bot_token             → DISCORD_BOT_TOKEN
#   field: allowed_users         → DISCORD_ALLOWED_USERS        (comma-sep user IDs)
#   field: home_channel_id       → DISCORD_HOME_CHANNEL
#   field: image_digest          → HERMES_IMAGE_DIGEST          (sha256:...)
#
# ── Item: hermes/llm-provider ────────────────────────────────────────────────
#   field: openai_api_key        → OPENAI_API_KEY               (if not in profile)
#   field: anthropic_api_key     → ANTHROPIC_API_KEY            (if not in profile)
#
# ── Rendering .env ────────────────────────────────────────────────────────────
#   BW_SESSION=$(bw unlock --passwordenv BW_PASSWORD --raw)
#   export BW_SESSION
#   DISCORD_BOT_TOKEN=$(bw get item "hermes/discord" | jq -r '.fields[] | select(.name=="bot_token") | .value')
#   # ... repeat for other fields
#   # Write to .env with mode 600
