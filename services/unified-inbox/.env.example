# Unified Inbox local/dev environment template.
# Values here are placeholders or Vaultwarden reference names only. Do not commit rendered secrets.

HOST=127.0.0.1
PORT=8766
NODE_ENV=development

# Active writable state must be host-local, not NAS/NFS.
UNIFIED_INBOX_RUNTIME_ROOT=./state

# Immutable exported snapshots/manifests may target NAS after batch close.
UNIFIED_INBOX_NAS_ROOT=./state/nas-export

# Optional future Postgres query projection. Render from Vaultwarden if enabled.
# Vaultwarden: folder=homelab item=unified-inbox/database/projection field=database_url
UNIFIED_INBOX_DATABASE_URL_REF=homelab/unified-inbox/database/projection#database_url

# App/session secret reference for future authenticated UI/session support.
# Vaultwarden: folder=homelab item=unified-inbox/app field=session_secret
UNIFIED_INBOX_SESSION_SECRET_REF=homelab/unified-inbox/app#session_secret
