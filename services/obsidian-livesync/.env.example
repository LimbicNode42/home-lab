# Rendered non-secret example for services/obsidian-livesync/.env
# Copy to .env locally or render from Vaultwarden using:
#   scripts/secrets/render-env-from-vaultwarden.sh services/obsidian-livesync/obsidian-livesync.env.map.example > services/obsidian-livesync/.env
#   chmod 0600 services/obsidian-livesync/.env
#
# Real .env files are ignored by Git. This example carries only references and
# non-secret literals — never values.
#
# NOTE: COUCHDB_USER / COUCHDB_PASSWORD are the CouchDB image's authoritative
# env names (the image ignores COUCHDB_ADMIN_*). Deployment is via
# `docker run --env-file`, so these names go straight into the container env.

# --- CouchDB admin (management/ops only) ----------------------------------
# Vaultwarden: folder Homelab, item obsidian-livesync/couchdb
COUCHDB_USER=REPLACE_WITH_VAULTWARDEN_COUCHDB_USER
COUCHDB_PASSWORD=REPLACE_WITH_VAULTWARDEN_COUCHDB_PASSWORD

# --- LiveSync client credential (the Obsidian client's CouchDB user) ------
# Vaultwarden: folder Homelab, item obsidian-livesync/livesync
# Used only at provisioning time to create the `obsidian` database and scoped user.
LIVESYNC_USER=REPLACE_WITH_VAULTWARDEN_LIVESYNC_USER
LIVESYNC_PASSWORD=REPLACE_WITH_VAULTWARDEN_LIVESYNC_PASSWORD