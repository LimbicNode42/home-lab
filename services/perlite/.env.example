# Perlite settings — Ben's homelab vault viewer (empty scaffold, LAN-only)
# Copy to .env and adjust. See upstream .env.example for full field list:
#   https://github.com/secure-77/Perlite/blob/main/.env.example

# --- General ---
NOTES_PATH=/mnt/nas/obsidian/vault
VAULT_NAME=Ben Vault
HOME_FILE=README
SITE_TITLE=Notes

# --- Frontend ---
LINE_BREAKS=true
DISABLE_POP_HOVER=false
SHOW_TOC=true
SHOW_LOCAL_GRAPH=true
FONT_SIZE=15
HIDE_FOLDERS=
NICE_LINKS=true
TREE_VISIBLE_EXTENSIONS=pdf,docx

# --- Advanced ---
HIDDEN_FILE_ACCESS=false
ABSOLUTE_PATHS=false
URI_PATH=/
HTML_SAFE_MODE=true
ZETTELKASTEN_FILENAMES_ENABLED=false
HIGHLIGHTJS_LANGS=powershell,python
ALLOWED_FILE_LINK_TYPES=pdf,mp4
CANVAS_IFRAME_EMBEDS=click
TEMP_PATH=

# --- Metadata ---
SITE_TYPE=website
SITE_IMAGE=
SITE_URL=http://192.168.0.50:8484
SITE_DESC="Ben's personal notes"
SITE_NAME=Notes

# --- Profile ---
SITE_LOGO=
SITE_HOMEPAGE=
SITE_GITHUB=
SITE_TWITTER=