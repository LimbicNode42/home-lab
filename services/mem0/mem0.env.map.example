# Vaultwarden folder/item/field map for rendering services/mem0/.env
# Folder: Homelab
# Item: mem0/server
#
# Field name in Vaultwarden -> env var name
postgres_password -> POSTGRES_PASSWORD
jwt_secret -> JWT_SECRET
admin_api_key -> ADMIN_API_KEY
api_key -> MEM0_API_KEY
api_url -> MEM0_API_URL
dashboard_url -> MEM0_DASHBOARD_URL
