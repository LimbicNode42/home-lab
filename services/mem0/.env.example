# Copy to .env locally or render from Vaultwarden. Real .env is ignored by Git.
# Secrets live in Vaultwarden item `mem0/server` (folder Homelab).

# LLM provider — OpenRouter (mem0's OpenAI LLM auto-routes when this is set).
OPENROUTER_API_KEY=REPLACE_WITH_OPENROUTER_API_KEY

# Embedder provider — OpenAI.
OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY

# Postgres (password is required).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_VAULTWARDEN_POSTGRES_PASSWORD
POSTGRES_DB=postgres
POSTGRES_COLLECTION_NAME=memories

# Auth.
JWT_SECRET=REPLACE_WITH_VAULTWARDEN_JWT_SECRET
ADMIN_API_KEY=REPLACE_WITH_VAULTWARDEN_ADMIN_API_KEY
APP_DB_NAME=mem0_app
AUTH_DISABLED=false

# Models.
MEM0_DEFAULT_LLM_MODEL=openai/gpt-4o-mini
MEM0_DEFAULT_EMBEDDER_MODEL=text-embedding-3-small

# Telemetry off.
MEM0_TELEMETRY=false

DASHBOARD_URL=http://127.0.0.1:3000
