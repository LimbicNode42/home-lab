# Non-secret defaults only. Do not commit a rendered .env with secrets.
# Candidate live target: critical LXC at 192.168.0.50.
# Publish dashboard only on the Docker bridge host gateway; Traefik reaches it via 172.17.0.1:4322.
DASHBOARD_PUBLISHED_IP=172.17.0.1
DASHBOARD_AUTH_MODE=reverse-proxy

# For public exposure through Cloudflare Access, cloudflared forwards this
# authenticated identity header to Traefik/the origin. If Ben chooses Traefik
# forward-auth instead, replace this with that proxy's trusted identity header.
DASHBOARD_PROXY_USER_HEADER=cf-access-authenticated-user-email
DASHBOARD_STATUS_CACHE_TTL_MS=30000
DASHBOARD_STATUS_PROBE_TIMEOUT_MS=2500

# Host-local runtime cache mounted into the dashboard for read-only config/report/Kanban artifacts.
# Fill it with scripts/sync-runtime-snapshots.sh before container recreate and from any periodic
# refresh job. This cache must be local storage on critical, not the NAS/NFS mount, so Docker does
# not preserve stale NFS handles inside the running container.
# PERSONAL_DASHBOARD_RUNTIME_CACHE_DIR=/var/lib/personal-dashboard/runtime-cache

# Host-side read-only Kanban DB snapshot source directory for completed epics / board APIs.
# Do not bind /root/.hermes/kanban.db directly: it is commonly root:root 0600
# under a 0700 directory, while the dashboard container runs as USER node.
# The deploy scripts copy kanban.db into PERSONAL_DASHBOARD_RUNTIME_CACHE_DIR/kanban;
# the running container reads /app/kanban/kanban.db from that host-local cache.
# KANBAN_DB_HOST_DIR=/mnt/nas/services/personal-dashboard/kanban

# Finnick report directory on the host running the dashboard container (critical LXC).
# Written by kobold cron on tori via the shared NAS mount (/mnt/pve/NAS on tori,
# /mnt/nas on critical). Default works without a .env file as long as NAS is mounted.
# The deploy scripts copy latest_report.txt into PERSONAL_DASHBOARD_RUNTIME_CACHE_DIR/finnick;
# the running container reads /app/finnick/latest_report.txt from that host-local cache.
# FINNICK_REPORT_HOST_DIR=/mnt/nas/services/personal-dashboard/finnick

# Investment screener NAS-backed data tree. The deploy scripts copy this directory into
# PERSONAL_DASHBOARD_RUNTIME_CACHE_DIR/investment-screener; the running container reads
# legacy latest_report.txt/latest_ranked.json and, when present, the file-first
# manifests/runs/duckdb tree from that host-local cache.
# INVESTMENT_SCREENER_HOST_DIR=/mnt/nas/services/personal-dashboard/investment-screener
# INVESTMENT_SCREENER_DATA_ROOT=/app

# Sensitive Diary/Goals runtime database. This should use Ben's shared Postgres
# service on critical over the Docker-local `critical-internal` network, not a
# container-local SQLite file or a raw Docker bridge IP. Render the URL from
# Vaultwarden folder `homelab`, item `personal-dashboard/database`, field
# `database_url`, changing only the URL host component to `postgres` after the
# network/alias source-of-truth is applied. Preserve username, password, port,
# database name, and TLS parameters; do not rotate values.
# PERSONAL_DASHBOARD_DATABASE_URL=REPLACE_WITH_VAULTWARDEN_DATABASE_URL
PGSSLMODE=require

# Stable Docker-local Postgres endpoint. `run-critical-docker.sh` creates this
# internal network when absent, attaches the existing `postgres` container with
# alias `postgres`, and then attaches the dashboard container to it. Live apply
# still requires explicit approval because it mutates Docker networking and
# recreates the dashboard container.
# PERSONAL_DASHBOARD_DB_NETWORK=critical-internal
# PERSONAL_DASHBOARD_DB_ALIAS=postgres

# Repo documentation root inside the container. The Docker image copies the dashboard
# README here so /api/docs/dashboard-readme does not depend on /root/work existing.
# REPO_DOCS_ROOT=/app/repo-docs

# Local development only. Production start refuses disabled auth unless this is explicitly true.
# DASHBOARD_AUTH_MODE=disabled
# DASHBOARD_ALLOW_DISABLED_AUTH=true
