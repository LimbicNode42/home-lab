{
  "title": "Home Dashboard",
  "sections": [
    {
      "title": "Core services",
      "links": [
        {
          "label": "Vaultwarden",
          "href": "https://vault.wheeler-network.com"
        },
        {
          "label": "Traefik",
          "href": "https://traefik.wheeler-network.com"
        }
      ]
    },
    {
      "title": "Operational runbooks",
      "links": [
        {
          "label": "Mem0 service runbook",
          "href": "/api/docs/mem0-service-runbook"
        },
        {
          "label": "Mem0 Hermes rollout / rollback",
          "href": "/api/docs/mem0-hermes-rollout"
        }
      ]
    }
  ],
  "statusChecks": [
    {
      "id": "vaultwarden",
      "label": "Vaultwarden",
      "targetUrl": "http://192.168.0.50:8084/alive",
      "displayUrl": "https://vault.wheeler-network.com"
    },
    {
      "id": "mem0-health",
      "label": "Mem0 memory provider",
      "type": "mem0Health",
      "baseUrl": "http://127.0.0.1:8888",
      "sshHost": "192.168.0.20",
      "sshUser": "root",
      "sshPort": 22,
      "apiKeyEnv": "MEM0_API_KEY",
      "searchUserId": "dashboard-smoke",
      "dockerContainers": [
        "mem0-mem0-1",
        "mem0-postgres-1"
      ],
      "logContainers": [
        "mem0-mem0-1"
      ],
      "logSinceSeconds": 900,
      "logTail": 200
    },
    {
      "id": "mem0-backup",
      "label": "Mem0 backup freshness",
      "type": "backupFreshness",
      "backupDir": "/app/mem0-backups",
      "manifestFile": "MANIFEST.txt",
      "maxAgeHours": 36
    },
    {
      "id": "knowledge-graph",
      "label": "Graphiti / Neo4j knowledge graph",
      "type": "graphitiNeo4jHealth",
      "graphiti": {
        "deployed": false
      },
      "neo4j": {
        "deployed": false
      }
    }
  ]
}
