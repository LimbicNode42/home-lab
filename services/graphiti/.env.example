# Graphiti candidate runtime environment.
# Render the real /opt/graphiti/.env from Vaultwarden with mode 0600. Do not commit it.

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
GRAPHITI_COMPLETION_MODEL=openai/gpt-4o-mini
GRAPHITI_RERANK_MODEL=openai/gpt-4o-mini
GRAPHITI_EMBEDDING_MODEL=openai/text-embedding-3-small
GRAPHITI_EMBEDDING_DIM=1536

# Required for deployment: reviewed immutable Graphiti API image digest.
# Do not use mutable tags such as latest.
GRAPHITI_IMAGE=zepai/graphiti@sha256:REPLACE_WITH_REVIEWED_64_HEX_DIGEST

# Vaultwarden: folder Homelab (case-sensitive), item graphiti/openrouter, LOGIN password or custom field api_key
OPENROUTER_API_KEY=REPLACE_WITH_VAULTWARDEN_GRAPHITI_OPENROUTER_API_KEY

# Vaultwarden: folder Homelab (case-sensitive), item graphiti/neo4j, fields username/password
NEO4J_USER=neo4j
NEO4J_PASSWORD=REPLACE_WITH_VAULTWARDEN_GRAPHITI_NEO4J_PASSWORD

# Future tori-local paths; live data stays local, NAS receives dumps/snapshots only.
GRAPHITI_NEO4J_DATA_DIR=/var/lib/graphiti/neo4j/data
GRAPHITI_NEO4J_LOG_DIR=/var/log/graphiti/neo4j
GRAPHITI_NAS_BACKUP_DIR=/mnt/pve/NAS/services/graphiti/backups/neo4j-dumps
GRAPHITI_NAS_SNAPSHOT_DIR=/mnt/pve/NAS/services/graphiti/config-snapshots
GRAPHITI_NAS_RESTORE_TEST_DIR=/mnt/pve/NAS/services/graphiti/restore-tests

GRAPHITI_API_PORT=8000
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_HEAP_INITIAL=512m
NEO4J_HEAP_MAX=1g
NEO4J_PAGECACHE=512m
