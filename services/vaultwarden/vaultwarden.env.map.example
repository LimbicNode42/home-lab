# ENV_NAME|folder|item|field
#
# This mapping contains Vaultwarden item/field references only. It is safe to
# commit. The rendered .env contains secrets and must stay untracked.

DOMAIN|homelab|vaultwarden/service|domain
DATABASE_URL|homelab|vaultwarden/database|database_url
SIGNUPS_ALLOWED|homelab|vaultwarden/service|signups_allowed
# ADMIN_TOKEN|homelab|vaultwarden/admin|admin_token
