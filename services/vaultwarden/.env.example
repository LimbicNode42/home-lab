# Copy to .env locally or render from Vaultwarden using:
#   scripts/secrets/render-env-from-vaultwarden.sh services/vaultwarden/vaultwarden.env.map.example > services/vaultwarden/.env
#   chmod 0600 services/vaultwarden/.env
#
# Real .env files are ignored by Git.

# Observed via public API config on 2026-05-22.
DOMAIN=https://vault.wheeler-network.com

# Secret-bearing database connection string. Store the real value in Vaultwarden:
#   folder: homelab
#   item: vaultwarden/database
#   field: database_url
DATABASE_URL=REPLACE_WITH_VAULTWARDEN_DATABASE_URL

# Approved target: disable new user registration during compose migration.
SIGNUPS_ALLOWED=false

# Optional: admin UI token. Leave unset unless intentionally enabled.
# ADMIN_TOKEN=REPLACE_ME
