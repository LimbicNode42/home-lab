# memory-reconciler runtime environment (non-secret, render from Vaultwarden).
# Render the real /opt/memory-reconciler/.env from Vaultwarden with mode 0600.
# Do NOT commit the rendered file or any value.

# --- Source + state (tori-local; state.db must NOT be on NAS/NFS) ---------
MEMORY_RECONCILER_KANBAN_DB=/root/.hermes/kanban.db
MEMORY_RECONCILER_STATE_DB=/var/lib/memory-reconciler/state.db

# --- mem0 (self-hosted) ---------------------------------------------------
# Vaultwarden: folder Homelab, item memory-reconciler/mem0, field api_key
MEMORY_RECONCILER_MEM0_HOST=http://127.0.0.1:8888
MEMORY_RECONCILER_MEM0_USER_ID=ben-gremlin
MEMORY_RECONCILER_MEM0_AGENT_ID=memory-reconciler
MEM0_API_KEY=REPLACE_WITH_VAULTWARDEN_MEM0_API_KEY

# --- Graphiti (loopback-only) --------------------------------------------
# Vaultwarden: folder Homelab, item memory-reconciler/graphiti, field api_key
MEMORY_RECONCILER_GRAPHITI_URL=http://127.0.0.1:8000
GRAPHITI_OPENROUTER_API_KEY=REPLACE_WITH_VAULTWARDEN_GRAPHITI_OPENROUTER_API_KEY

# --- OpenRouter model allowlist (curated-ingest-policy section 8.1) -------
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
GRAPHITI_COMPLETION_MODEL=openai/gpt-4o-mini
GRAPHITI_RERANK_MODEL=openai/gpt-4o-mini
GRAPHITI_EMBEDDING_MODEL=openai/text-embedding-3-small
GRAPHITI_EMBEDDING_DIM=1536