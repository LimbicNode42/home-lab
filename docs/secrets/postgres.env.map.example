# Example Vaultwarden dotenv mapping.
# Format:
#   ENV_NAME|Vaultwarden folder|Vaultwarden item name|field name
#
# This file intentionally contains no secret values.
# The selected folder for homelab secrets is `homelab`.

PG_HOST|homelab|postgres/admin|host
PG_PORT|homelab|postgres/admin|port
PG_USER|homelab|postgres/admin|username
PG_PASSWORD|homelab|postgres/admin|password
